   <text:h text:style-name="P9" text:outline-level="2">DAWN BRIEFING</text:h>
   <text:p text:style-name="P11">You Have Been Drafted</text:p>
   <text:h text:style-name="Heading_20_3" text:outline-level="3">Inspection</text:h>
   <text:list text:style-name="List_20_1">
    <text:list-item>
     <text:p text:style-name="P30">Brief Sweep of the Physical Environment</text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="Heading_20_3" text:outline-level="3">Review</text:h>
   <text:list text:continue-numbering="true" text:style-name="List_20_1">
    <text:list-item>
     <text:p text:style-name="P31">Review your OPERATING STANCE</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P31">Review DAWN CONTEXT PAGE</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P32">Review Recent GENERAL LOG notes</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P31">What obligations, meetings, or events are there today?</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P31">What missions are underway?</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P33">Take a quick glance at your BRANCH chart</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P31">What’s the next actionable step for each?</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P31">Review any calendars or to-do lists you keep.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P31">Review FATIGUE DUTY Chart</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P31">Review MESS HALL: What morale, nutrition, or recovery actions are needed?</text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="Heading_20_3" text:outline-level="3">Planning</text:h>
   <text:list xml:id="list153916285229150" text:continue-numbering="true" text:style-name="List_20_1">
    <text:list-item>
     <text:p text:style-name="P31">Record Today’s Intentions.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P31">Expected Hazards and Traps: What might go wrong? What ambushes are likely?</text:p>
    </text:list-item>
   </text:list>
   <text:list text:style-name="Numbering_20_123">
    <text:list-header>
     <text:p text:style-name="P34"/>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P7">Standby.... Ready..... GO!</text:p>
   <text:p text:style-name="P7"/>
   <text:p text:style-name="P7"/>
   <text:p text:style-name="P7"/>
   <text:p text:style-name="P7"/>
   <text:p text:style-name="P7"/>
   <text:p text:style-name="P7"><text:soft-page-break/></text:p>
   <text:p text:style-name="P21"><text:span text:style-name="T14">DAWN</text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T14">BRIEFING</text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T16">CONTEXT PAGE</text:span></text:p>
   <text:p text:style-name="P10"/>
   <text:p text:style-name="P10"/>
   <text:p text:style-name="P10"/>
   <text:p text:style-name="P10"/>
   <text:p text:style-name="P10"/>
   <text:p text:style-name="P10"/>
   <text:p text:style-name="P10"/>
